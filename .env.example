JWT_SECRET=change-me-to-a-long-random-string
MANAGER_SETUP_SECRET=optional-secret-for-self-promotion
OWNER_EMAIL=
DATABASE_PATH=data/holysmokes.db
SECURE_COOKIES=false

# Catering email — use SMTP, SendGrid, or Mailgun
# For SendGrid: set SMTP_HOST=smtp.sendgrid.net and put the API key in SMTP_PASS or SENDGRID_API_KEY
# For Mailgun: set MAILGUN_API_KEY and MAILGUN_DOMAIN (e.g., mg.holysmokes.cc)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
SMTP_FROM=catering@holysmokes.cc
SMTP_TO=catering@holysmokes.cc
SMTP_STARTTLS=true
