JWT_SECRET=change-me-to-a-long-random-string
MANAGER_SETUP_SECRET=optional-secret-for-self-promotion
OWNER_EMAIL=
DATABASE_PATH=data/holysmokes.db
SECURE_COOKIES=false

# Catering email — use SMTP, SendGrid, or Mailgun
# For SendGrid: set SMTP_HOST=smtp.sendgrid.net and put the API key in SMTP_PASS or SENDGRID_API_KEY
# For Mailgun: set MAILGUN_API_KEY and MAILGUN_DOMAIN (e.g., mg.holysmokes.cc)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Set EMAIL_FROM_DOMAIN to the domain emails should be sent from (e.g. holysmokes.cc).
EMAIL_FROM_DOMAIN=holysmokes.cc
# Optional: public URL of the site, used for the email signature logo.
PUBLIC_URL=https://holysmokes.cc
# Secret token for the Mailgun inbound webhook (optional but recommended).
EMAIL_WEBHOOK_SECRET=
SMTP_FROM=catering@holysmokes.cc
SMTP_TO=catering@holysmokes.cc
SMTP_STARTTLS=true

# Team email (Zoho)
# Comma-separated list of first-name locals allowed to send/reply from @holysmokes.cc
OUTGOING_EMAIL_USERS=griffin,asa
# Zoho region: com, eu, or in
ZOHO_REGION=com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Refresh tokens for each mailbox that may send email (used over HTTPS to avoid SMTP blocks)
ZOHO_GRIFFIN_REFRESH_TOKEN=
ZOHO_ASA_REFRESH_TOKEN=
# Optional: if no refresh token, app-specific SMTP credentials will be tried
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_GRIFFIN_USER=griffin@holysmokes.cc
ZOHO_GRIFFIN_PASS=
ZOHO_ASA_USER=asa@holysmokes.cc
ZOHO_ASA_PASS=
